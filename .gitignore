# Python
__pycache__/
*.py[cod]
*.egg-info/
dist/
build/
.eggs/

# Virtual environments
venv/
env/
.env

# Data (too large for git — use DVC or store separately)
data/synthetic/generated/
data/crypto/raw/
data/lobster/*.csv
data/processed/
data/raw/
data/lobster/
*.csv
*.parquet
*.h5
evaluation/results_scaled_down_sweep/viz_data.json
evaluation/results_scaled_down_sweep/stylized_facts.json

# Model weights (large — track with git-lfs or W&B artifacts)
*.pt
*.pth
*.pkl
checkpoints/*
# Exception: small pretrained encoder inputs required by encoder=autoencoder
# runs (not training-run outputs) — must ship with the repo.
!checkpoints/ae_encoder_*.pt
!checkpoints/ae_history_*.json

# Training logs and Hydra run directories (regenerated per run, not tracked)
logs/
outputs/
multirun/
.pytest_cache/

# Retired/superseded checkpoints+logs kept locally for reversibility (e.g. a
# bug-fix invalidates a prior run) — same status as checkpoints/logs above,
# just moved aside instead of overwritten. Includes raw .npz arrays not
# covered by the *.pt/*.pth/*.pkl rule below.
archive/

# Experiment outputs (tracked via W&B, not git)
wandb/

# Notebooks checkpoints
.ipynb_checkpoints/

# OS
.DS_Store
.idea/
.vscode/

# Secrets
.env
*.key
